    "adapter": {"rank": 1, "alpha": 4, "dropout": 0.1},
    "criterion": "mean held-out gradient specificity",
    "tie_break": ["smaller_depth", "smaller_learning_rate"],
    "selected": {
      "mmlu": {"learning_rate": 1e-5, "depth": 2},
      "bbh": {"learning_rate": 1e-5, "depth": 2},
      "tydiqa": {"learning_rate": 1e-5, "depth": 64}
    }
  },
  "selection": {
    "score": "normalized loss drop from checkpoint 1 to selected depth",
    "fraction": 0.05
  },
  "retraining": {
    "adapter": {"rank": 128, "alpha": 512, "dropout": 0.1},
    "epochs": 4,
    "effective_batch_size": 32,
    "learning_rate_grid": [1e-5, 2e-5, 5e-5]
  }
