{
  "model": "meta-llama/Llama-3.2-3B",
  "precision": "bfloat16",
  "max_sequence_length": 2048,
  "candidate_sources": {
    "flan_v2": 100000,
    "cot": 100000,
    "oasst1": 55668,
    "dolly": 15011
  },
  "target_proxies": {
    "mmlu": {"rows": 285, "prompt_format": "5-shot"},
